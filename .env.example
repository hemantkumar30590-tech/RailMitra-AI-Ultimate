# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RAPIDAPI_KEY: Required for live train status, PNR, and trains-between.
# Primary host: irctc-api5.p.rapidapi.com
# Copy this file to .env.local and paste your real key.
RAPIDAPI_KEY="MY_RAPIDAPI_KEY"
RAPIDAPI_IRCTC_HOST="irctc-api5.p.rapidapi.com"
RAPIDAPI_IRCTC1_HOST="irctc1.p.rapidapi.com"
RAPIDAPI_RAIL_HOST="rail-info-api-india1.p.rapidapi.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Fallback AI model key
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
