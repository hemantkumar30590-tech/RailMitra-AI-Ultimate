{
  "name": "RailMitra AI",
  "short_name": "RailMitra",
  "description": "A live train status lookup application for Indian Railways.",
  "categories": ["travel", "utilities"],
  "lang": "en",
  "id": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
